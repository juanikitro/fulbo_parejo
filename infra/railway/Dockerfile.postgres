FROM supabase/postgres:17.6.1.136
COPY infra/railway/99-service-roles.sql /docker-entrypoint-initdb.d/init-scripts/99-service-roles.sql
ENV PGDATA=/var/lib/postgresql/data/fulbo
CMD ["postgres", "-c", "config_file=/etc/postgresql/postgresql.conf", "-c", "data_directory=/var/lib/postgresql/data/fulbo", "-c", "log_min_messages=fatal"]
